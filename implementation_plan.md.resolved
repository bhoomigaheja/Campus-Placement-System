## 4. Final Django Models

### `accounts/models.py`
```python
from django.contrib.auth.models import AbstractUser
from django.db import models

class User(AbstractUser):
    is_student = models.BooleanField(default=False)
    is_tpo = models.BooleanField(default=False)
    email = models.EmailField(unique=True)
    
    USERNAME_FIELD = 'email'
    REQUIRED_FIELDS = ['username']
```

### `students/models.py`
```python
from django.db import models
from django.conf import settings
from core.models import BaseModel # Presumes an abstract model with created_at, updated_at

class Branch(BaseModel):
    name = models.CharField(max_length=100, unique=True)
    code = models.CharField(max_length=20, unique=True)

class Skill(BaseModel):
    name = models.CharField(max_length=50, unique=True)

class StudentProfile(BaseModel):
    user = models.OneToOneField(settings.AUTH_USER_MODEL, on_delete=models.CASCADE, related_name='student_profile')
    branch = models.ForeignKey(Branch, on_delete=models.SET_NULL, null=True)
    cgpa = models.DecimalField(max_digits=4, decimal_places=2)
    resume = models.FileField(upload_to='resumes/%Y/%m/')
    skills = models.ManyToManyField(Skill, blank=True)
    projects = models.TextField(blank=True)
    internships = models.TextField(blank=True)
    
    def __str__(self):
        return f"{self.user.get_full_name()} - {self.user.username}"
```

### `placements/models.py`
```python
from django.db import models
from students.models import StudentProfile, Branch

class Company(models.Model):
    name = models.CharField(max_length=255, unique=True)
    website = models.URLField(blank=True)
    description = models.TextField()

class PlacementDrive(models.Model):
    company = models.ForeignKey(Company, on_delete=models.CASCADE, related_name='drives')
    job_role = models.CharField(max_length=255)
    salary_package = models.CharField(max_length=100)
    min_cgpa = models.DecimalField(max_digits=4, decimal_places=2)
    eligible_branches = models.ManyToManyField(Branch)
    deadline_to_apply = models.DateTimeField()
    created_at = models.DateTimeField(auto_now_add=True)

class Application(models.Model):
    STATUS_CHOICES = (
        ('APPLIED', 'Applied'),
        ('SHORTLISTED', 'Shortlisted'),
        ('INTERVIEW', 'Interview'),
        ('SELECTED', 'Selected'),
        ('REJECTED', 'Rejected'),
    )
    student = models.ForeignKey(StudentProfile, on_delete=models.CASCADE, related_name='applications')
    drive = models.ForeignKey(PlacementDrive, on_delete=models.CASCADE, related_name='applications')
    status = models.CharField(max_length=20, choices=STATUS_CHOICES, default='APPLIED')
    applied_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        constraints = [
            models.UniqueConstraint(fields=['student', 'drive'], name='unique_application')
        ]

class InterviewSchedule(models.Model):
    application = models.ForeignKey(Application, on_delete=models.CASCADE, related_name='interviews')
    round_name = models.CharField(max_length=100) # e.g., 'Technical Round 1'
    date = models.DateField()
    time = models.TimeField()
    meeting_link_or_location = models.CharField(max_length=255)
    created_at = models.DateTimeField(auto_now_add=True)
```

