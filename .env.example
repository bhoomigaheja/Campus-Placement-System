# Django Application settings
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,https://*.onrender.com

# Database Connection (Leave blank to use local SQLite)
# Example: postgres://db_user:db_password@db_host:5432/db_name
DATABASE_URL=

# Celery & Caching (Redis)
# REDIS_URL=redis://localhost:6379/0
